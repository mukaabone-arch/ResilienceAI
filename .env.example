# Copy to .env and change the passwords. Never commit .env.
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# development: demo sign-in ("act as") is allowed. production: the API refuses to start
# unless AUTH_MODE=oidc, non-default passwords and a non-local evidence store are set.
APP_ENV=development
AUTH_MODE=dev

# Microsoft Entra ID sign-in (AUTH_MODE=oidc). See docs/DEPLOYMENT.md, "Microsoft Entra ID sign-in".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ROLES_FROM_TOKEN=true

# Notifications: "simulated" sends nothing. "m365" sends Outlook mail and calendar invitations through
# Microsoft Graph and Teams messages through a Teams Workflows webhook. See docs/DEPLOYMENT.md, "Teams and Outlook".
NOTIFY_MODE=simulated
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
TEAMS_WEBHOOK_URL=

EVIDENCE_STORE=local
EVIDENCE_MAX_MB=25

# Secure evidence storage (production): any S3-compatible store with Object Lock, plus ClamAV.
# To try it on this machine: docker compose --profile secure-storage up -d, with these values:
#   EVIDENCE_STORE=s3  EVIDENCE_S3_ENDPOINT=http://minio:9000  EVIDENCE_S3_BUCKET=resilienceai-evidence
#   EVIDENCE_S3_SSE=AES256  EVIDENCE_RETENTION_DAYS=30  SCANNER=clamav
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = the MinIO user and password below
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_REGION=ap-south-1
EVIDENCE_S3_SSE=aws:kms
EVIDENCE_S3_KMS_KEY_ID=
EVIDENCE_RETENTION_DAYS=0
EVIDENCE_RETENTION_MODE=COMPLIANCE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SCANNER=builtin

# Assistant: "rules" needs no external service. "anthropic" lets Claude reword suggestions.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Evidence pre-checks: rule checks run on every readable upload ("off" disables them). With AI_PROVIDER=anthropic the
# worker also asks the model whether the file covers its activity, from a masked excerpt with names replaced.
EVIDENCE_PRECHECK=on
EVIDENCE_LOOKBACK_DAYS=14

WEB_PORT=3000
PORTAL_BASE_URL=http://localhost:3000

# Monitoring: GET /health/deep needs this token (header X-Monitoring-Token); empty turns it off.
MONITORING_TOKEN=
AUDIT_VERIFY_HOURS=24
